{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@movie-desk/core": ["../../packages/core/src/index.ts"],
      "@movie-desk/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    ".next/types/**/*.ts",
    ".next-ci/types/**/*.ts",
    ".next-gate/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
