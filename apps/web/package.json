{
  "name": "@movie-desk/web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome lint src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome format --write src e2e playwright.config.ts",
    "knip": "pnpm --dir ../.. exec knip --workspace apps/web",
    "prebundle:mediapipe": "node scripts/download-mediapipe-models.mjs",
    "prebundle:whisper": "node scripts/download-whisper.mjs",
    "prebundle:models": "pnpm run prebundle:mediapipe && pnpm run prebundle:whisper"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@movie-desk/core": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.2",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "exifr": "^7.1.3",
    "lucide-react": "^0.460.0",
    "mediabunny": "1.55.5",
    "mp4box": "^2.3.0",
    "next": "^15.5.22",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
