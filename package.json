{
  "name": "movie-desk",
  "version": "0.3.1",
  "private": true,
  "description": "Movie Desk — an AI-native, local-first video editor that turns raw moments into finished movies.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @movie-desk/web dev",
    "build": "pnpm --filter @movie-desk/web build",
    "start": "pnpm --filter @movie-desk/web start",
    "lint": "pnpm -r lint && biome check scripts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "sync:versions": "node scripts/check-versions.mjs --write",
    "test:e2e": "pnpm --filter @movie-desk/web test:e2e",
    "audit:prod": "node scripts/osv-audit.mjs",
    "format": "pnpm -r format && biome format --write scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "comment": "Transitive pins that carry a published advisory. Each entry is the lowest version OSV reports as fixed or newer; drop an entry once the parent package ships a range that already satisfies it (scripts/osv-audit.mjs is the gate).",
    "overrides": {
      "js-yaml": "4.2.0",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "sharp": "0.35.3",
      "adm-zip": "0.6.0",
      "nanoid@<4": "3.3.18",
      "nanoid@>=4": "5.1.16"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "knip": "^6.14.2"
  }
}
